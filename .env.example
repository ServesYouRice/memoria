# Database
# Local Docker: postgresql://canvascollect:devpassword@localhost:5432/canvascollect
# Neon (free): postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_PASSWORD="devpassword"
DATABASE_URL="postgresql://canvascollect:devpassword@localhost:5432/canvascollect"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Auth.js
  AUTH_URL="http://localhost:3000"
  # Optional deployment tuning; defaults to 5 credential-changing requests
  # per client IP per 15 minutes.
  AUTH_RATE_LIMIT_MAX_REQUESTS="5"
AUTH_SECRET="replace-me-with-a-32-plus-character-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-with-a-32-plus-character-secret"
APP_BOOTSTRAP_TOKEN="replace-me-with-a-bootstrap-token"
REGISTRATION_MODE="open"
INTERNAL_OPERATIONS_TOKEN="replace-me-with-a-32-plus-character-operations-token"
OPERATIONS_BASE_URL="http://127.0.0.1:3002"
GRAFANA_ADMIN_PASSWORD="replace-with-a-distinct-random-admin-password"

# Node Environment
NODE_ENV="development"

# Optional: Logging level
LOG_LEVEL="info"

# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For. Leave empty
# when Memoria is directly reachable so caller-supplied forwarding is ignored.
TRUSTED_PROXY_CIDRS=""

# Optional: Feature flags
FEATURE_BOOKMARK_UNFURLING="true"

# Sentry (Observability)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Email
# SMTP is intentionally disabled in this build; use console, sendgrid, or resend.
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@memoria.local"
EMAIL_FROM_NAME="Memoria"
EMAIL_SENDER_VERIFIED="false"
EMAIL_DELIVERY_PROBE_TO=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SENDGRID_API_KEY=""
RESEND_API_KEY=""
MODEL_CREDENTIAL_ENCRYPTION_KEY=""

# Scheduled maintenance (required by the scheduler service)
CRON_SECRET="replace-me-with-a-32-plus-character-secret"
BOOKMARK_REFRESH_INTERVAL_MS="900000"

# Uploads
# local is development-only; production must use s3
UPLOAD_STORAGE="s3"
UPLOADS_PUBLIC_URL="http://localhost:9000/memoria-uploads"
UPLOAD_SCAN_URL=""
UPLOAD_SCAN_REQUIRED="false"
UPLOAD_SCAN_TIMEOUT_MS="10000"

# S3-compatible storage
S3_BUCKET="memoria-uploads"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"

# Separate, versioned recovery storage. Use a dedicated account/bucket in production.
BACKUP_BUCKET="memoria-backups"
BACKUP_RETENTION_DAYS="35"
BACKUP_MANIFEST_HMAC_KEY="replace-with-a-random-32-byte-secret"
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="us-east-1"
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_SSE="AES256"
BACKUP_INTERVAL_SECONDS="3600"
MAX_BACKUP_AGE_SECONDS="5400"
BACKUP_FRESHNESS_INTERVAL_SECONDS="900"

# MinIO (local self-host reference stack)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin123"

# AI Integration
OPENAI_API_KEY=""
AI_ACTION_BUDGET_DAILY="1000"
