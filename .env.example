# Database
# Local Docker: postgresql://canvascollect:devpassword@localhost:5432/canvascollect
# Neon (free): postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/canvas_collect"

# Redis (Optional - for caching/rate-limiting)
# Local Docker: redis://localhost:6379
# Upstash (free): rediss://default:token@xxx.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# Auth.js (NextAuth)
# Production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Node Environment
NODE_ENV="development"

# Optional: Logging level
LOG_LEVEL="info"

# Optional: Feature flags
FEATURE_BOOKMARK_UNFURLING="true"

# AI Integration
OPENAI_API_KEY=""

# Sentry (Observability)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Uploads (optional)
UPLOAD_STORAGE="local" # local | s3
UPLOADS_PUBLIC_URL=""
UPLOAD_SCAN_URL=""
UPLOAD_SCAN_REQUIRED="false"
UPLOAD_SCAN_TIMEOUT_MS="10000"

# S3-compatible storage (optional)
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
