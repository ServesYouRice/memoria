# ============================================================================
# CanvasCollect Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
#
# Quick setup:
#   1. cp .env.example .env
#   2. Update DATABASE_URL with your PostgreSQL credentials
#   3. Generate NEXTAUTH_SECRET: openssl rand -base64 32
#   4. Run: ./scripts/setup-database.sh
# ============================================================================

# ----------------------------------------------------------------------------
# Database (REQUIRED)
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Local development:
DATABASE_URL="postgresql://canvasuser:yourpassword@localhost:5432/canvas_collect"
#
# Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/canvas_collect"
#
# Production (with connection pooling):
# DATABASE_URL="postgresql://user:pass@host:5432/db?connection_limit=10&pool_timeout=10"
#
# See docs/DATABASE_SETUP.md for detailed setup instructions

# ----------------------------------------------------------------------------
# Authentication (REQUIRED)
# ----------------------------------------------------------------------------
# NextAuth.js configuration
# Base URL for your application
NEXTAUTH_URL="http://localhost:3000"

# Secret for JWT encryption (IMPORTANT: Generate a secure random string!)
# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# ----------------------------------------------------------------------------
# Node Environment
# ----------------------------------------------------------------------------
# Options: development, test, production
NODE_ENV="development"

# ----------------------------------------------------------------------------
# Logging (Optional)
# ----------------------------------------------------------------------------
# Log level for Pino logger
# Options: trace, debug, info, warn, error, fatal
LOG_LEVEL="info"

# ----------------------------------------------------------------------------
# Redis/Upstash (Optional - Production Recommended)
# ----------------------------------------------------------------------------
# For production-ready rate limiting (see CODE_AUDIT_REPORT.md Issue #5)
# Sign up at: https://upstash.com/
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_token_here"

# ----------------------------------------------------------------------------
# CORS Configuration (Optional - Issue #15)
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins for API requests
# Development default: http://localhost:3000,http://127.0.0.1:3000
# Production: Set to your actual domain(s)
# CORS_ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"

# Wildcard subdomain support (use with caution):
# CORS_ALLOWED_ORIGINS="*.example.com"

# Allowed HTTP methods (default: GET,POST,PUT,PATCH,DELETE,OPTIONS)
# CORS_ALLOWED_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"

# Allow credentials (cookies, auth headers) - default: true
# CORS_ALLOW_CREDENTIALS="true"

# Preflight cache duration in seconds (default: 86400 = 24 hours)
# CORS_MAX_AGE="86400"

# ----------------------------------------------------------------------------
# Feature Flags (Optional)
# ----------------------------------------------------------------------------
# Enable/disable experimental features
# FEATURE_BOOKMARK_UNFURLING="false"  # Phase 2 feature

# ----------------------------------------------------------------------------
# OAuth Providers (Optional)
# ----------------------------------------------------------------------------
# Google OAuth (if you want to enable Google sign-in)
# Get credentials at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID="your_client_id"
# GOOGLE_CLIENT_SECRET="your_client_secret"

# GitHub OAuth (if you want to enable GitHub sign-in)
# Get credentials at: https://github.com/settings/developers
# GITHUB_CLIENT_ID="your_client_id"
# GITHUB_CLIENT_SECRET="your_client_secret"

# ----------------------------------------------------------------------------
# Monitoring & Analytics (Optional)
# ----------------------------------------------------------------------------
# Sentry for error tracking
# SENTRY_DSN="https://your-sentry-dsn"
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="your-project"

# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID="your_analytics_id"

# ----------------------------------------------------------------------------
# Email (Optional - for password reset, etc.)
# ----------------------------------------------------------------------------
# Email provider configuration (e.g., SendGrid, Resend, etc.)
# EMAIL_SERVER="smtp://username:password@smtp.example.com:587"
# EMAIL_FROM="noreply@example.com"

# ----------------------------------------------------------------------------
# Storage (Optional - for file uploads)
# ----------------------------------------------------------------------------
# S3-compatible storage (AWS S3, Cloudflare R2, etc.)
# S3_BUCKET="your-bucket"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY="your-access-key"
# S3_SECRET_KEY="your-secret-key"

# ----------------------------------------------------------------------------
# Production Overrides
# ----------------------------------------------------------------------------
# These are typically set by your hosting provider (Vercel, Railway, etc.)
# and don't need to be in your .env file

# DATABASE_URL - Set by hosting provider
# NEXTAUTH_URL - Auto-detected in production
# VERCEL_URL - Auto-set by Vercel
# PORT - Set by hosting provider (default: 3000)
