    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate-api-keys": "tsx scripts/migrate-api-keys.ts",
    "db:migrate-notes": "tsx scripts/migrate-note-content.ts",
    "report:limit-violations": "tsx scripts/report-limit-violations.ts",
    "maintenance:enqueue-retention": "tsx scripts/enqueue-retention.ts",
    "backup:check": "bash scripts/check-backup-freshness.sh",
    "audit": "pnpm audit --audit-level=moderate",
    "check-bundle": "node scripts/check-bundle-size.mjs",
    "check-schema-drift": "node scripts/check-schema-drift.mjs",
    "ci": "pnpm run lint && pnpm run type-check && pnpm run test:coverage && pnpm run audit && pnpm run build && pnpm run test:e2e",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
