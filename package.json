{
  "name": "memoria",
  "short_name": "Memoria",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "node scripts/build.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "node scripts/start-server.mjs",
    "setup:dev": "node scripts/setup.mjs dev",
    "setup:selfhost": "node scripts/setup.mjs selfhost",
    "doctor": "node scripts/doctor.mjs",
