{
  "name": "memoria",
  "short_name": "Memoria",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "node scripts/build.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "node scripts/start-server.mjs",
    "worker:outbox": "node scripts/start-outbox-worker.mjs",
    "worker:outbox:dev": "tsx scripts/outbox-worker.ts",
    "setup:dev": "node scripts/setup.mjs dev",
