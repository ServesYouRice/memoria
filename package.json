    "stack:down": "node scripts/stack.mjs down",
    "stack:logs": "node scripts/stack.mjs logs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "percy exec -- playwright test tests/e2e/visual/",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "audit": "pnpm audit --audit-level=moderate",
    "check-bundle": "node scripts/check-bundle-size.mjs",
    "ci": "pnpm run lint && pnpm run type-check && pnpm run test:coverage && pnpm run audit && pnpm run build && pnpm run test:e2e",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
