# Reference ingress for the custom Node/WebSocket server. Compose sets
# MEMORIA_ADDRESS=:3000; a standalone TLS deployment can set it to its domain.
# MEMORIA_APP_UPSTREAMS and MEMORIA_SYNC_UPSTREAMS list the replicas
# (space-separated); the `replicas` compose profile sets two of each (IMP-043).

{$MEMORIA_ADDRESS:localhost} {
	route {
		# Internal operations stay on the loopback-only app port. Returning 404
		# keeps their existence hidden at public ingress.
		@blocked_operations {
			path /api/ready /api/metrics /api/operations/* /api/internal/*
		}
		respond @blocked_operations "" 404

		header {
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}

		# Framing stays denied everywhere except signed embed pages, whose
		# CSP frame-ancestors (set by the app per embed) is the allow-list.
		# A gateway-level DENY here would override it and block allowed hosts;
		# the app still sends DENY itself for invalid or revoked embed tokens.
		@not_embed not path /embed/*
		header @not_embed X-Frame-Options "DENY"

		# Liveness and sanitized status remain reachable even when readiness
		# removes the application from ordinary traffic.
		@public_probes {
			path /api/health /api/status
		}
		reverse_proxy @public_probes {$MEMORIA_APP_UPSTREAMS:app:3000}

		# Every collaboration socket (document sync and presence) belongs to the
		# realtime process, which authenticates and authorizes each connection
		# itself. Replicas share state through PostgreSQL and Redis, so any
		# replica can take any connection (IMP-043).
		@collaboration {
			path /api/collaboration/*
		}
		reverse_proxy @collaboration {$MEMORIA_SYNC_UPSTREAMS:sync:3001} {
			health_uri /ready
			health_interval 5s
			health_timeout 3s
			health_status 2xx
			header_up X-Real-IP {remote_host}
		}

		@upload_paths {
			path /api/v1/upload /api/v1/canvases/*/thumbnail
		}
		request_body @upload_paths {
			max_size 50MB
		}
		@ordinary_paths not path /api/v1/upload /api/v1/canvases/*/thumbnail
		request_body @ordinary_paths {
			max_size 2MB
		}

		# Active authenticated readiness removes an upstream from user traffic
		# after one failed check and restores it after one pass.
		reverse_proxy {$MEMORIA_APP_UPSTREAMS:app:3000} {
			health_uri /api/ready
			health_interval 5s
			health_timeout 3s
			health_fails 1
			health_passes 1
			health_status 2xx
			health_headers {
				Authorization "Bearer {$INTERNAL_OPERATIONS_TOKEN}"
			}
			fail_duration 30s
			max_fails 1
			unhealthy_status 5xx
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}
