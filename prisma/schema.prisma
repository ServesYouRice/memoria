generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

// Prisma 7 moved the connection URL out of the schema; migrate and the CLI read
// it from `prisma.config.ts`, and the client receives it through the pg adapter
// constructed in `src/lib/db.ts`.
datasource db {
  provider = "postgresql"
}

// Better Auth owns User, Session, Account, Verification, TwoFactor, and
// Passkey (IMP-041). The password hash lives on the `credential` Account row;
// Argon2id hashing and verification stay in `src/lib/auth/password.ts`.
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    Boolean   @default(false)
  emailVerifiedAt  DateTime?
  name             String?
  image            String?
  twoFactorEnabled Boolean   @default(false)
  /// Saved links get a title, tags and summary in the background (IMP-064).
  autoEnrichLinks  Boolean   @default(true)
  /// Look saved links up in a public web archive (IMP-094). Off by default;
  /// sends the link address to a third party.
  webArchiveLookup Boolean   @default(false)
  /// The person's own words on how things are tagged (IMP-106); null means
  /// the standard behaviour. Sent to the AI as their rules, never page data.
  taggingRules     String?   @db.VarChar(1000)
  /// Inbox items move to a suggested board on their own when it is a confident match (IMP-066).
  autoFileItems    Boolean   @default(false)
  /// The weekly recap also arrives by email; in-app only by default (IMP-070).
  weeklyRecapEmail Boolean   @default(false)
  /// A link nobody opened for this many weeks counts as stale (IMP-070).
  staleLinkWeeks   Int       @default(6)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  canvases   Canvas[]
  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
  passkeys   Passkey[]
  workspaces Workspace[]

  createdVersions CanvasVersion[] @relation("VersionCreatedBy")
  createdItems    CanvasItem[]    @relation("ItemCreatedBy")
  updatedItems    CanvasItem[]    @relation("ItemUpdatedBy")
  deletedItems    CanvasItem[]    @relation("ItemDeletedBy")
  comments        Comment[]

  activities              Activity[]
  apiKeys                 ApiKey[]
  agentProfiles           AgentProfile[]
  modelCredentials        ModelCredential[]
  agentActions            AgentAction[]
  changeSets              ChangeSet[]
  suggestions             Suggestion[]
  knowledgeEntities       KnowledgeEntity[]
  knowledgeRelations      KnowledgeRelation[]
  workspaceCheckpoints    WorkspaceCheckpoint[]
  canvasViews             CanvasView[]
  agentJobs               AgentJob[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthTokens             OAuthToken[]
  uploadAssets            UploadAsset[]
  uploadQuota             UploadQuota?
  receivedShares          CanvasShare[]            @relation("ShareRecipient")
  sentShareInvitations    CanvasShareInvitation[]  @relation("InvitationSender")
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationActions     Notification[]           @relation("NotificationActor")
  notificationPreferences NotificationPreference[]
  accountExports          AccountExport[]
  bookmarkImports         BookmarkImport[]
  clipBatches             ClipBatch[]
  weeklyRecaps            WeeklyRecap[]
  itemReminders           ItemReminder[]
  pollVotes               PollVote[]
  pollClosures            PollClosure[]
}

enum AccountExportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum BookmarkImportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum BookmarkImportDestination {
  INBOX
  FOLDERS
}

/// A bookmark file being imported in the background (IMP-091). `links` holds
/// the validated rows; `cursor` is the next row to import and moves forward
/// in the same transaction as the items it imports, so a rerun resumes.
model BookmarkImport {
  id             String                    @id @default(cuid())
  userId         String
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         BookmarkImportStatus      @default(QUEUED)
  destination    BookmarkImportDestination
  enrich         Boolean                   @default(false)
  fileName       String
  format         String
  fileHash       String
  links          Json
  total          Int
  cursor         Int                       @default(0)
  imported       Int                       @default(0)
  duplicates     Int                       @default(0)
  overLimit      Int                       @default(0)
  invalid        Int                       @default(0)
  failed         Int                       @default(0)
  /// Folder name -> canvas id for FOLDERS imports.
  folderCanvases Json                      @default("{}")
  lastError      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([userId, createdAt])
}

model AccountExport {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            AccountExportStatus @default(QUEUED)
  formatVersion     Int                 @default(2)
  storageMode       String
  storageKey        String?             @unique
  byteSize          BigInt?
  sha256            String?
  manifest          Json?
  lastError         String?
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  expiresAt         DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model Activity {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ActivityType
  canvasId   String?
  canvasName String?
  itemId     String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([canvasId, createdAt])
}

enum ActivityType {
  CANVAS_CREATED
  CANVAS_UPDATED
  CANVAS_DELETED
  CANVAS_SHARED
  ITEM_CREATED
  ITEM_UPDATED
  ITEM_DELETED
  COMMENT_ADDED
  TEMPLATE_CREATED
  TEMPLATE_USED
  WORKSPACE_AGENT_NOTES_UPDATED
}

model Canvas {
  id               String                  @id @default(cuid())
  name             String                  @default("Untitled Canvas")
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            CanvasItem[]
  shares           CanvasShare[]
  shareInvitations CanvasShareInvitation[]
  notifications    Notification[]
  versions         CanvasVersion[]
  document         CanvasDocument?
  embeds           CanvasEmbed[]
  clipBatches      ClipBatch[]

  zoomLevel Float @default(1.0)
  panX      Float @default(0)
  panY      Float @default(0)

  thumbnailKey         String?
  thumbnailRevision    BigInt                     @default(0)
  restoreRevision      Int                        @default(0)
  /// Last per-canvas item event number handed out (`CanvasEvent.canvasSequence`).
  eventSequence        BigInt                     @default(0)
  thumbnailCandidates  CanvasThumbnailCandidate[]
  /// Agent checkpoints of this canvas; they are deleted with it.
  workspaceCheckpoints WorkspaceCheckpoint[]

  // Sharing settings
  isPublic   Boolean @default(false)
  shareToken String? @unique // For public sharing links

  // Template settings
  isTemplate          Boolean @default(false)
  templateDescription String?
  templateCategory    String?
  usageCount          Int     @default(0)

  workspaceId  String?
  workspace    Workspace?       @relation(fields: [workspaceId], references: [id])
  canvasViews  CanvasView[]
  connections  ItemConnection[]
  uploadAssets UploadAsset[]
  /// Items from other canvases shown here too (IMP-109).
  placements   ItemPlacement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([userId, isTemplate]) // For template listing by user (Issue #12)
  @@index([shareToken])
  @@index([isPublic]) // For public canvas discovery (Issue #12)
  @@index([isTemplate, templateCategory])
  @@index([isTemplate, usageCount, createdAt])
  @@index([workspaceId])
}

/// Signed, revocable read-only embed of a canvas. Only the SHA-256 digest of
/// the token is stored; the token itself is shown once at creation.
model CanvasEmbed {
  id             String    @id @default(cuid())
  canvasId       String
  canvas         Canvas    @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  label          String    @default("")
  tokenDigest    String    @unique
  allowedOrigins String[]
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([canvasId, createdAt])
}

/// IMP-046: `MANUAL` versions are named by a person (and never expire);
/// `AUTO` versions are taken by the `versions.auto-snapshot` job and thinned
/// out by `versions.auto-retention`.
enum CanvasVersionKind {
  MANUAL
  AUTO
}

model CanvasVersion {
  id          String            @id @default(cuid())
  canvasId    String
  canvas      Canvas            @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  name        String
  snapshot    Json // Complete canvas state including items
  /// Encoded Yjs state the snapshot was derived from (IMP-042); null for
  /// versions taken before the canvas had a collaborative document.
  yjsState    Bytes?
  kind        CanvasVersionKind @default(MANUAL)
  /// The person who saved or restored a manual version; null for automatic
  /// snapshots and once that account is deleted.
  createdById String?
  createdBy   User?             @relation("VersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// SHA-256 of the canvas content (items, ignoring view position), used to
  /// skip an automatic snapshot that would repeat the latest version.
  contentHash String?
  createdAt   DateTime          @default(now())

  @@index([canvasId, createdAt])
  @@index([canvasId, kind, createdAt])
  @@index([createdById])
}

model CanvasItem {
  id       String   @id @default(cuid())
  canvasId String
  canvas   Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  type     ItemType

  positionX Float
  positionY Float
  width     Float
  height    Float
  zIndex    Int   @default(0)

  content      Json
  tags         String[]                 @default([])
  searchVector Unsupported("tsvector")?

  version   Int       @default(1)
  deletedAt DateTime?

  createdById String
  updatedById String?
  deletedById String?
  createdBy   User    @relation("ItemCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?   @relation("ItemUpdatedBy", fields: [updatedById], references: [id])
  deletedBy   User?   @relation("ItemDeletedBy", fields: [deletedById], references: [id])

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  bookmarkRefreshedAt DateTime?
  /// Bookmark URL normalized for "you saved this already" (IMP-065).
  normalizedUrl       String?
  /// Last time the owner opened the link (IMP-070); null before tracking began.
  lastOpenedAt        DateTime?
  /// Set with deletedAt when the item went to the archive: the trash sweep keeps it.
  archivedAt          DateTime?

  comments            Comment[]
  connectionsFrom     ItemConnection[]     @relation("ConnectionFrom")
  connectionsTo       ItemConnection[]     @relation("ConnectionTo")
  entityLinks         ItemEntityLink[]
  embeddings          ItemEmbedding[]
  clipBatchItems      ClipBatchItem[]
  enrichment          ItemEnrichment?
  pageCopy            ItemPageCopy?
  homeBoardSuggestion HomeBoardSuggestion?
  reminders           ItemReminder[]
  pollVotes           PollVote[]
  pollClosure         PollClosure?
  notifications       Notification[]
  /// The other canvases this item also shows on (IMP-109).
  placements          ItemPlacement[]

  @@index([canvasId, deletedAt])
  @@index([normalizedUrl])
  @@index([canvasId, type])
  @@index([canvasId, zIndex])
  @@index([canvasId, updatedAt])
  @@index([canvasId, positionX, positionY])
  @@index([canvasId, createdById]) // For filtering by creator (Issue #12)
  @@index([searchVector], type: Gin, map: "idx_canvas_item_fts")
  @@index([tags], type: Gin, map: "idx_canvas_item_tags_gin")
}

model CanvasThumbnailCandidate {
  id        String   @id @default(cuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  revision  BigInt
  mimeType  String
  bytes     Bytes
  createdAt DateTime @default(now())

  @@unique([canvasId, revision])
  @@index([createdAt])
}

model Comment {
  id        String     @id @default(cuid())
  itemId    String
  item      CanvasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String     @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@index([itemId, deletedAt])
  @@index([itemId, createdAt]) // For chronological comments (Issue #12)
  @@index([userId])
  @@index([createdAt])
}

enum ItemType {
  NOTE
  BOOKMARK
  IMAGE
  DRAWING
  SHAPE
  ARROW
  TEXT
  FRAME
  EMBED
  POLL
  TABLE
}

enum ShareRole {
  VIEW // Can only view
  COMMENT // Can view and comment
  EDIT // Can view, comment, and edit
}

model CanvasShare {
  id          String    @id @default(cuid())
  canvasId    String
  canvas      Canvas    @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  email       String // Email of person shared with
  recipientId String?
  recipient   User?     @relation("ShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  role        ShareRole @default(VIEW)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([canvasId, email])
  @@index([canvasId])
  @@index([email])
}

enum ShareInvitationResponse {
  ACCEPTED
  DECLINED
  REVOKED
}

model CanvasShareInvitation {
  id             String                   @id @default(cuid())
  canvasId       String
  canvas         Canvas                   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User                     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  email          String
  role           ShareRole                @default(VIEW)
  tokenHash      String                   @unique
  deliverySecret String
  expiresAt      DateTime
  respondedAt    DateTime?
  response       ShareInvitationResponse?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([canvasId, email, respondedAt])
  @@index([expiresAt, respondedAt])
}

enum NotificationType {
  SHARE_INVITATION_ACCEPTED
  SHARE_INVITATION_DECLINED
  CANVAS_SHARED
  WEEKLY_RECAP
  ITEM_REMINDER
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  canvasId    String?
  canvas      Canvas?          @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  /// The item a reminder notification opens (IMP-097).
  itemId      String?
  item        CanvasItem?      @relation(fields: [itemId], references: [id], onDelete: SetNull)
  type        NotificationType
  subject     String
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, readAt, createdAt])
}

/// "Remind me" on an item (IMP-097). One per person and item; it belongs to
/// the person who set it and is checked against their access when it fires.
model ItemReminder {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String
  item        CanvasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  remindAt    DateTime
  firedAt     DateTime?
  cancelledAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, itemId])
  @@index([remindAt])
  @@index([userId, remindAt])
}

/// IMP-104: one person's vote for one choice of a poll item. Votes are
/// written only by the poll vote route; the shared document never holds them.
model PollVote {
  id        String     @id @default(cuid())
  itemId    String
  item      CanvasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  choiceId  String
  createdAt DateTime   @default(now())

  @@unique([itemId, userId, choiceId])
  @@index([itemId, choiceId])
}

/// IMP-104: the canvas owner closed this poll; it takes no more votes.
model PollClosure {
  itemId     String     @id
  item       CanvasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  closedById String
  closedBy   User       @relation(fields: [closedById], references: [id], onDelete: Cascade)
  closedAt   DateTime   @default(now())

  @@index([closedById])
}

model NotificationPreference {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  inAppEnabled Boolean          @default(true)
  emailEnabled Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

// Short-lived Better Auth values: passkey challenges, two-factor sign-in
// challenges, and trusted-device records. Identifiers are stored hashed.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  secret                  String
  backupCodes             String    @db.Text
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  name         String?
  publicKey    String    @db.Text
  credentialID String    @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, expiresAt])
  @@index([token, expiresAt])
}

model EmailVerificationToken {
  id             String    @id @default(cuid())
  token          String    @unique
  email          String
  expiresAt      DateTime
  usedAt         DateTime?
  deliverySecret String?
  createdAt      DateTime  @default(now())

  @@index([email, expiresAt])
  @@index([token, expiresAt])
}

// Phase 5: New Models

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model ItemConnection {
  id        String     @id @default(cuid())
  canvasId  String
  canvas    Canvas     @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  fromId    String
  fromItem  CanvasItem @relation("ConnectionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  toItem    CanvasItem @relation("ConnectionTo", fields: [toId], references: [id], onDelete: Cascade)
  label     String?
  style     String     @default("SOLID")
  createdAt DateTime   @default(now())

  @@unique([canvasId, fromId, toId])
  @@index([canvasId])
  @@index([fromId])
  @@index([toId])
}

// Workspace model - allows users to organize canvases into groups
model Workspace {
  id         String   @id @default(cuid())
  name       String
  /// The owner's standing notes for AI agents working here (IMP-107). Sent to
  /// agents as the owner's guidance; they never change what agents may do.
  agentNotes String?  @db.VarChar(2000)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvases   Canvas[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String
  userId      String
  path        String
  method      String
  createdAt   DateTime @default(now())
  lockedAt    DateTime @default(now())
  requestHash String?

  responseCode Int?
  responseBody Json?

  @@unique([key, userId, method, path])
  @@index([userId, key])
  @@index([createdAt]) // For cleanup cron jobs
}

model ApiKey {
  id         String    @id @default(cuid())
  key        String    @unique
  keyPrefix  String?
  keySuffix  String?
  name       String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
  @@index([key])
}

enum AgentProfileStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum ModelProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  OPENROUTER
  OPENAI_COMPAT
}

enum CredentialStatus {
  ACTIVE
  UNVERIFIED
  DISABLED
  ERROR
}

enum IntegrationProviderType {
  OPENCLAW
  WHATSAPP
  WEBHOOK
  CUSTOM
}

enum IntegrationAuthMode {
  TOKEN
  HMAC
  OAUTH_PROXY
}

enum IntegrationStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum AgentActionKind {
  READ
  INGEST
  COMMENT
  PROPOSE
  WRITE
  EXECUTE_EXTERNAL
  ROLLBACK
}

enum AgentActionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  REVERTED
  APPROVAL_REQUIRED
}

enum ChangeSetStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  REVERTED
}

enum SuggestionKind {
  INTERNAL_ORGANIZATION
  EXTERNAL_ACTION
}

enum SuggestionStatus {
  OPEN
  APPROVED
  EXECUTING
  REJECTED
  EXPIRED
  EXECUTED
}

enum KnowledgeEntityStatus {
  ACTIVE
  ARCHIVED
}

model UploadAsset {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvasId    String
  canvas      Canvas            @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  storageKey  String            @unique
  storageMode String
  filename    String
  mimeType    String
  size        Int
  status      UploadAssetStatus @default(PENDING)
  lastError   String?
  // The text note the upload.note job made from this file (IMP-071). Set in
  // the same transaction that creates the note, so a repeated job skips. Not a
  // foreign key: notes are soft-deleted, and re-requesting clears it.
  noteItemId  String?
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([canvasId, createdAt])
  @@index([status, createdAt])
}

model RegistrationInvite {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, expiresAt])
  @@index([usedAt, expiresAt])
}

enum KnowledgeRelationStatus {
  ACTIVE
  ARCHIVED
}

enum ItemEntityLinkType {
  SOURCE
  TAGGED
  MENTIONED
  SUMMARIZED
  CLUSTERED
}

enum WorkspaceCheckpointActorType {
  USER
  AGENT
  SYSTEM
}

enum CanvasViewType {
  MANUAL
  ORGANIZER
}

enum AgentJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model AgentProfile {
  id                       String                   @id @default(cuid())
  userId                   String
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String
  status                   AgentProfileStatus       @default(ACTIVE)
  maxCapabilityRung        Int                      @default(3)
  enabledRungs             Int[]                    @default([0, 1, 2, 3])
  allowedCanvasIds         String[]                 @default([])
  /// Marks a built-in profile ("organizer"). Set only by the server, never
  /// from the API; NULL for every profile a user creates.
  systemKey                String?
  defaultModelCredentialId String?
  defaultModelCredential   ModelCredential?         @relation("DefaultModelCredential", fields: [defaultModelCredentialId], references: [id], onDelete: SetNull)
  integrationAccounts      IntegrationAccount[]
  agentActions             AgentAction[]
  changeSets               ChangeSet[]
  suggestions              Suggestion[]
  jobs                     AgentJob[]
  oauthAuthorizationCodes  OAuthAuthorizationCode[]
  oauthTokens              OAuthToken[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@unique([userId, systemKey])
  @@index([userId, status])
  @@index([defaultModelCredentialId])
}

model ModelCredential {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           ModelProvider
  label              String
  baseUrl            String?
  defaultModel       String
  encryptedSecret    String
  secretFingerprint  String
  capabilities       Json?
  dailySpendCap      Float?
  monthlySpendCap    Float?
  status             CredentialStatus @default(UNVERIFIED)
  lastVerifiedAt     DateTime?
  defaultForProfiles AgentProfile[]   @relation("DefaultModelCredential")
  agentActions       AgentAction[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, secretFingerprint])
  @@index([userId, provider, status])
}

model IntegrationAccount {
  id                    String                  @id @default(cuid())
  agentProfileId        String
  agentProfile          AgentProfile            @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  providerType          IntegrationProviderType
  externalAccountId     String
  authMode              IntegrationAuthMode
  encryptedSecretOrHash String
  secretPrefix          String?
  secretSuffix          String?
  replayCursor          Json?
  status                IntegrationStatus       @default(ACTIVE)
  lastSeenAt            DateTime?
  agentActions          AgentAction[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([agentProfileId, providerType, externalAccountId])
  @@index([agentProfileId, status])
  @@index([secretPrefix, secretSuffix])
}

model AgentAction {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentProfileId       String
  agentProfile         AgentProfile        @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  integrationAccountId String?
  integrationAccount   IntegrationAccount? @relation(fields: [integrationAccountId], references: [id], onDelete: SetNull)
  modelCredentialId    String?
  modelCredential      ModelCredential?    @relation(fields: [modelCredentialId], references: [id], onDelete: SetNull)
  kind                 AgentActionKind
  rung                 Int
  status               AgentActionStatus
  summary              String
  requestFingerprint   String
  metadata             Json?
  changeSets           ChangeSet[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([agentProfileId, createdAt])
  @@index([requestFingerprint])
}

model ChangeSet {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentProfileId String
  agentProfile   AgentProfile    @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  agentActionId  String?
  agentAction    AgentAction?    @relation(fields: [agentActionId], references: [id], onDelete: SetNull)
  scopeType      String
  scopeId        String
  status         ChangeSetStatus
  summary        String
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  revertedAt     DateTime?
  changeRecords  ChangeRecord[]

  @@index([userId, startedAt])
  @@index([agentActionId])
  @@index([scopeType, scopeId])
}

model ChangeRecord {
  id          String    @id @default(cuid())
  changeSetId String
  changeSet   ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  targetType  String
  targetId    String
  operation   String
  before      Json?
  after       Json?
  reversible  Boolean   @default(true)
  revertedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([changeSetId])
  @@index([targetType, targetId])
}

model Suggestion {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentProfileId String?
  agentProfile   AgentProfile?    @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  kind           SuggestionKind
  status         SuggestionStatus @default(OPEN)
  summary        String
  payload        Json
  expiresAt      DateTime
  actedAt        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, status, expiresAt])
  @@index([agentProfileId, createdAt])
}

model KnowledgeEntity {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType        String
  title             String
  summary           String?
  status            KnowledgeEntityStatus @default(ACTIVE)
  attributes        Json?
  sourceConfidence  Float?
  itemLinks         ItemEntityLink[]
  outgoingRelations KnowledgeRelation[]   @relation("KnowledgeRelationSource")
  incomingRelations KnowledgeRelation[]   @relation("KnowledgeRelationTarget")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([userId, entityType])
  @@index([userId, title])
}

model KnowledgeRelation {
  id             String                  @id @default(cuid())
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEntityId String
  sourceEntity   KnowledgeEntity         @relation("KnowledgeRelationSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntityId String
  targetEntity   KnowledgeEntity         @relation("KnowledgeRelationTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)
  relationType   String
  summary        String?
  status         KnowledgeRelationStatus @default(ACTIVE)
  attributes     Json?
  confidence     Float?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([sourceEntityId, targetEntityId, relationType], map: "KnowledgeRelation_source_target_type_key")
  @@index([userId, relationType])
  @@index([sourceEntityId])
  @@index([targetEntityId])
}

model ItemEntityLink {
  id                String             @id @default(cuid())
  itemId            String
  item              CanvasItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  knowledgeEntityId String
  knowledgeEntity   KnowledgeEntity    @relation(fields: [knowledgeEntityId], references: [id], onDelete: Cascade)
  linkType          ItemEntityLinkType @default(SOURCE)
  confidence        Float?
  createdAt         DateTime           @default(now())

  @@unique([itemId, knowledgeEntityId, linkType])
  @@index([knowledgeEntityId])
}

model ItemEmbedding {
  id          String     @id @default(cuid())
  itemId      String
  item        CanvasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  provider    String
  model       String
  contentHash String
  vector      Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([itemId, provider, model])
  @@index([provider, model])
}

model WorkspaceCheckpoint {
  id                 String                       @id @default(cuid())
  userId             String
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopeType          String
  scopeId            String
  /// The checkpointed canvas for scopeType "canvas", so the rows go with it.
  canvasId           String?
  canvas             Canvas?                      @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  snapshot           Json
  reason             String
  createdByActorType WorkspaceCheckpointActorType
  createdByActorId   String
  createdAt          DateTime                     @default(now())

  @@index([userId, scopeType, scopeId, createdAt])
  @@index([scopeType, scopeId, createdAt])
  @@index([createdAt])
  @@index([canvasId])
}

model CanvasView {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvasId  String
  canvas    Canvas         @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  viewType  CanvasViewType
  name      String?
  filters   Json?
  layout    Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, canvasId, viewType])
  @@index([canvasId])
}

model AgentJob {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentProfileId String?
  agentProfile   AgentProfile?  @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  jobType        String
  status         AgentJobStatus @default(QUEUED)
  payload        Json
  result         Json?
  error          Json?
  scheduledAt    DateTime       @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, scheduledAt])
  @@index([agentProfileId, createdAt])
}

enum UploadAssetStatus {
  PENDING
  ACTIVE
  DELETING
  DELETED
  FAILED
  RECONCILING
}

model UploadQuota {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetCount Int      @default(0)
  totalBytes BigInt   @default(0)
  updatedAt  DateTime @updatedAt
}

enum OutboxJobStatus {
  PENDING
  RUNNING
  COMPLETED
  DEAD
}

model OutboxJob {
  id             String          @id @default(cuid())
  type           String
  payload        Json
  dedupeKey      String?         @unique
  status         OutboxJobStatus @default(PENDING)
  attempts       Int             @default(0)
  maxAttempts    Int             @default(8)
  nextRunAt      DateTime        @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, nextRunAt])
  @@index([status, leaseExpiresAt])
  @@index([completedAt])
}

/// IMP-042: one Yjs document per canvas, owned by the sync server process
/// (`scripts/sync-server.ts`). `state` holds the compacted document; accepted
/// updates since the last compaction are appended to `CanvasDocumentUpdate` in
/// the same transaction that projects them onto `CanvasItem` rows.
model CanvasDocument {
  canvasId         String                 @id
  canvas           Canvas                 @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  /// `Y.encodeStateAsUpdate` of the document through `compactedThrough`.
  state            Bytes
  /// Highest `CanvasDocumentUpdate.id` folded into `state`.
  compactedThrough BigInt                 @default(0)
  /// Highest `CanvasEvent.sequence` reconciled from rows into the document.
  eventSequence    BigInt                 @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  updates          CanvasDocumentUpdate[]
}

/// Append-only Yjs updates accepted by the sync server since the last
/// compaction. `actorId` is the editing user, or null for updates the sync
/// server derived from committed `CanvasItem` row changes.
model CanvasDocumentUpdate {
  id        BigInt         @id @default(autoincrement())
  canvasId  String
  document  CanvasDocument @relation(fields: [canvasId], references: [canvasId], onDelete: Cascade)
  update    Bytes
  actorId   String?
  createdAt DateTime       @default(now())

  @@index([canvasId, id])
}

model CanvasEvent {
  id              String   @id @default(cuid())
  sequence        BigInt   @unique @default(autoincrement())
  /// Contiguous per-canvas number of an item event, allocated from
  /// `Canvas.eventSequence`. Null for 'restored' events.
  canvasSequence  BigInt?
  canvasId        String
  actorId         String
  entityId        String
  entityVersion   Int
  operation       String
  permissionScope String   @default("VIEW")
  schemaVersion   Int      @default(1)
  createdAt       DateTime @default(now())

  @@unique([canvasId, canvasSequence])
  @@index([canvasId, sequence])
  @@index([createdAt])
}

// OAuth 2.1 authorization for remote MCP clients (Claude, ChatGPT, agents).
// Each consent creates an AgentProfile, so the existing capability rungs and
// canvas scope govern what a connected app can do.
model OAuthClient {
  id                      String                   @id @default(cuid())
  clientId                String                   @unique
  clientName              String
  redirectUris            String[]
  clientUri               String?
  // "none" for public PKCE clients; confidential clients get a hashed secret.
  tokenEndpointAuthMethod String                   @default("none")
  clientSecretHash        String?
  createdAt               DateTime                 @default(now())
  authorizationCodes      OAuthAuthorizationCode[]
  tokens                  OAuthToken[]
}

model OAuthAuthorizationCode {
  id             String       @id @default(cuid())
  codeHash       String       @unique
  clientId       String
  client         OAuthClient  @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  redirectUri    String
  codeChallenge  String
  scope          String
  resource       String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
}

model OAuthToken {
  id               String       @id @default(cuid())
  accessTokenHash  String       @unique
  refreshTokenHash String       @unique
  clientId         String
  client           OAuthClient  @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentProfileId   String
  agentProfile     AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  scope            String
  resource         String
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime     @default(now())

  @@index([userId, revokedAt])
  @@index([agentProfileId])
}

enum ClipBatchSource {
  EXTENSION
  SHARE_TARGET
}

/// One "save these links" request from the browser extension (IMP-061) or the
/// phone share target (IMP-062). The idempotency key makes a retried batch a
/// replay instead of a second set of items; the optional sorting note is read
/// by the Inbox sorter (IMP-063).
model ClipBatch {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvasId       String
  canvas         Canvas          @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  source         ClipBatchSource
  idempotencyKey String
  requestHash    String
  note           String?
  createdAt      DateTime        @default(now())
  items          ClipBatchItem[]

  @@unique([userId, idempotencyKey])
  @@index([canvasId, createdAt])
}

model ClipBatchItem {
  batchId  String
  batch    ClipBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemId   String
  item     CanvasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  position Int

  @@id([batchId, itemId])
  @@index([itemId])
}

enum ItemEnrichmentStatus {
  PENDING
  DONE
  SKIPPED
}

/// Background naming, tagging and summarizing of a saved link (IMP-064). The
/// base values are what the item held when it was saved: the job only replaces
/// a title or tag list that still equals them (or what it wrote itself), so a
/// user's edit always wins, and `filledFields` records what it filled.
model ItemEnrichment {
  itemId         String               @id
  item           CanvasItem           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Owner of the board, whose settings and AI budget the job uses.
  userId         String
  status         ItemEnrichmentStatus @default(PENDING)
  baseTitle      String?
  baseTags       String[]             @default([])
  /// The saver chose this title on purpose; keep it even if it is unchanged.
  titleLocked    Boolean              @default(false)
  filledFields   String[]             @default([])
  filledTitle    String?
  filledTags     String[]             @default([])
  /// Why the AI step did not run: not-configured, disabled, budget or provider-error.
  aiSkipReason   String?
  /// Other links of this user that look like the same page (embeddings, IMP-065).
  similarItemIds String[]             @default([])
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId, status])
  @@index([userId, completedAt])
}

/// The readable text of a saved link's page (IMP-094), kept so the link stays
/// useful after the site changes. Untrusted web content: shown as plain text
/// only and marked as data wherever AI reads it. Deleted with its item.
model ItemPageCopy {
  itemId           String                   @id
  item             CanvasItem               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Owner of the canvas, whose storage budget the copy counts against.
  userId           String
  /// The address that was read.
  url              String
  text             String
  /// UTF-8 size of `text`, summed for the per-account budget.
  textBytes        Int                      @default(0)
  readAt           DateTime?
  /// An existing public web-archive copy, when the lookup is on.
  archiveUrl       String?
  archiveCheckedAt DateTime?
  searchVector     Unsupported("tsvector")?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([userId])
  @@index([searchVector], type: Gin, map: "idx_item_page_copy_fts")
}

enum HomeBoardSuggestionStatus {
  OPEN
  ACCEPTED
  AUTO_FILED
  DISMISSED
  REVERTED
}

/// A suggested home board for an item in the Inbox (IMP-066). One row per item
/// ever, so a dismissed or undone suggestion is never proposed again. The move
/// itself runs through the item's `Suggestion` and is recorded as a ChangeSet.
model HomeBoardSuggestion {
  itemId         String                    @id
  item           CanvasItem                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Owner of the Inbox, who accepts, dismisses or undoes it.
  userId         String
  sourceCanvasId String
  /// Not a foreign key: deleting a board must not erase a dismissal.
  targetCanvasId String
  confidence     Float
  /// Why this board: board-name, tags or similar-items.
  reasons        String[]                  @default([])
  status         HomeBoardSuggestionStatus @default(OPEN)
  suggestionId   String?                   @unique
  changeSetId    String?
  actedAt        DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([userId, sourceCanvasId, status])
  @@index([userId, status, actedAt])
}

/// IMP-070: one recap per user per ISO week (Monday, UTC). The unique key is
/// what makes the weekly job safe to run twice: only the run that inserts the
/// row writes the notification and queues the email.
model WeeklyRecap {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart           DateTime
  periodStart         DateTime
  periodEnd           DateTime
  savedCount          Int       @default(0)
  /// Links saved in the period, newest first: [{ id, title, url }].
  savedLinks          Json
  /// Suggested piles for the period's links: [{ title, itemIds }].
  suggestedPiles      Json
  staleWeeks          Int
  staleCount          Int       @default(0)
  /// The stale links "Archive these" acts on (capped); re-checked at archive time.
  staleItemIds        String[]  @default([])
  notificationId      String?
  emailQueued         Boolean   @default(false)
  archivedChangeSetId String?
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@unique([userId, weekStart])
  @@index([userId, createdAt])
}

/// IMP-109: an item also shown on another canvas. The content lives once on
/// the item (its home canvas); a placement holds only where it sits here.
/// Deleting the item deletes its placements; trashing it hides them.
model ItemPlacement {
  id          String     @id @default(cuid())
  itemId      String
  item        CanvasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  canvasId    String
  canvas      Canvas     @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  positionX   Float
  positionY   Float
  width       Float
  height      Float
  zIndex      Int        @default(0)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([itemId, canvasId])
  @@index([canvasId])
}
