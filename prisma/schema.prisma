generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime? // null = not verified, DateTime = verified at
  name          String?
  image         String?
  sessionVersion Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  canvases      Canvas[]
  sessions      Session[]
  accounts      Account[]
  workspaces    Workspace[]

  createdItems  CanvasItem[] @relation("ItemCreatedBy")
  updatedItems  CanvasItem[] @relation("ItemUpdatedBy")
  deletedItems  CanvasItem[] @relation("ItemDeletedBy")
  comments      Comment[]

  activities    Activity[]
  apiKeys       ApiKey[]
  agentProfiles AgentProfile[]
  modelCredentials ModelCredential[]
  agentActions  AgentAction[]
  changeSets    ChangeSet[]
  suggestions   Suggestion[]
  knowledgeEntities KnowledgeEntity[]
  knowledgeRelations KnowledgeRelation[]
  workspaceCheckpoints WorkspaceCheckpoint[]
  canvasViews   CanvasView[]
  agentJobs     AgentJob[]
  uploadAssets  UploadAsset[]
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType
  canvasId    String?
  canvasName  String?
  itemId      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([canvasId, createdAt])
}

enum ActivityType {
  CANVAS_CREATED
  CANVAS_UPDATED
  CANVAS_DELETED
  CANVAS_SHARED
  ITEM_CREATED
  ITEM_UPDATED
  ITEM_DELETED
  COMMENT_ADDED
  TEMPLATE_CREATED
  TEMPLATE_USED
}

model Canvas {
  id          String      @id @default(cuid())
  name        String      @default("Untitled Canvas")
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CanvasItem[]
  shares      CanvasShare[]
  versions    CanvasVersion[]

  zoomLevel   Float       @default(1.0)
  panX        Float       @default(0)
  panY        Float       @default(0)

  // Thumbnail for preview (base64 encoded PNG)
  thumbnail   String?     @db.Text

  // Sharing settings
  isPublic    Boolean     @default(false)
  shareToken  String?     @unique // For public sharing links

  // Template settings
  isTemplate  Boolean     @default(false)
  templateDescription String?
  templateCategory String?
  usageCount  Int         @default(0)

  workspaceId String?
  workspace   Workspace?  @relation(fields: [workspaceId], references: [id])
  canvasViews CanvasView[]
  connections ItemConnection[]
  uploadAssets UploadAsset[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([userId, isTemplate]) // For template listing by user (Issue #12)
  @@index([shareToken])
  @@index([isPublic]) // For public canvas discovery (Issue #12)
  @@index([isTemplate, templateCategory])
  @@index([isTemplate, usageCount, createdAt])
  @@index([workspaceId])
}

model CanvasVersion {
  id          String   @id @default(cuid())
  canvasId    String
  canvas      Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  name        String
  snapshot    Json     // Complete canvas state including items
  createdAt   DateTime @default(now())

  @@index([canvasId, createdAt])
}

model CanvasItem {
  id          String   @id @default(cuid())
  canvasId    String
  canvas      Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  type        ItemType

  positionX   Float
  positionY   Float
  width       Float
  height      Float
  zIndex      Int      @default(0)

  content     Json
  tags        String[] @default([])

  version     Int      @default(1)
  deletedAt   DateTime?

  createdById String
  updatedById String?
  deletedById String?
  createdBy   User     @relation("ItemCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("ItemUpdatedBy", fields: [updatedById], references: [id])
  deletedBy   User?    @relation("ItemDeletedBy", fields: [deletedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([canvasId, deletedAt])
  @@index([canvasId, type])
  @@index([canvasId, zIndex])
  @@index([canvasId, updatedAt])
  @@index([canvasId, positionX, positionY])
  @@index([canvasId, createdById]) // For filtering by creator (Issue #12)

  comments      Comment[]
  connectionsFrom ItemConnection[] @relation("ConnectionFrom")
  connectionsTo   ItemConnection[] @relation("ConnectionTo")
  entityLinks   ItemEntityLink[]
  embeddings    ItemEmbedding[]
}

model Comment {
  id          String   @id @default(cuid())
  itemId      String
  item        CanvasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([itemId, deletedAt])
  @@index([itemId, createdAt]) // For chronological comments (Issue #12)
  @@index([userId])
  @@index([createdAt])
}

enum ItemType {
  NOTE
  BOOKMARK
  IMAGE
  DRAWING
  SHAPE
  ARROW
  TEXT
  FRAME
  EMBED
  POLL
}

enum ShareRole {
  VIEW    // Can only view
  COMMENT // Can view and comment
  EDIT    // Can view, comment, and edit
}

model CanvasShare {
  id        String    @id @default(cuid())
  canvasId  String
  canvas    Canvas    @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  email     String    // Email of person shared with
  role      ShareRole @default(VIEW)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([canvasId, email])
  @@index([canvasId])
  @@index([email])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceInfo   String?
  revokedAt    DateTime?

  @@index([userId])
  @@index([expires])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
  @@index([token, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
  @@index([token, expiresAt])
}

// Phase 5: New Models

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model ItemConnection {
  id        String   @id @default(cuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  fromId    String
  fromItem  CanvasItem @relation("ConnectionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  toItem    CanvasItem @relation("ConnectionTo", fields: [toId], references: [id], onDelete: Cascade)
  label     String?
  style     String   @default("SOLID")
  createdAt DateTime @default(now())

  @@unique([canvasId, fromId, toId])
  @@index([canvasId])
  @@index([fromId])
  @@index([toId])
}

// Workspace model - allows users to organize canvases into groups
model Workspace {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvases  Canvas[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String
  userId      String
  path        String
  method      String
  createdAt   DateTime @default(now())
  lockedAt    DateTime @default(now())
  requestHash String?
  
  responseCode Int?
  responseBody Json?

  @@unique([key, userId, method, path])
  @@index([userId, key])
  @@index([createdAt]) // For cleanup cron jobs
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  keyPrefix String?
  keySuffix String?
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime?
  lastUsedAt DateTime?
  revokedAt DateTime?
  
  @@index([userId])
  @@index([key])
}

enum AgentProfileStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum ModelProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  OPENROUTER
  OPENAI_COMPAT
}

enum CredentialStatus {
  ACTIVE
  UNVERIFIED
  DISABLED
  ERROR
}

enum IntegrationProviderType {
  OPENCLAW
  WHATSAPP
  WEBHOOK
  CUSTOM
}

enum IntegrationAuthMode {
  TOKEN
  HMAC
  OAUTH_PROXY
}

enum IntegrationStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum AgentActionKind {
  READ
  INGEST
  COMMENT
  PROPOSE
  WRITE
  EXECUTE_EXTERNAL
  ROLLBACK
}

enum AgentActionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  REVERTED
  APPROVAL_REQUIRED
}

enum ChangeSetStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  REVERTED
}

enum SuggestionKind {
  INTERNAL_ORGANIZATION
  EXTERNAL_ACTION
}

enum SuggestionStatus {
  OPEN
  APPROVED
  EXECUTING
  REJECTED
  EXPIRED
  EXECUTED
}

enum KnowledgeEntityStatus {
  ACTIVE
  ARCHIVED
}

model UploadAsset {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvasId    String
  canvas      Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  storageKey  String   @unique
  storageMode String
  filename    String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([canvasId, createdAt])
}

enum KnowledgeRelationStatus {
  ACTIVE
  ARCHIVED
}

enum ItemEntityLinkType {
  SOURCE
  TAGGED
  MENTIONED
  SUMMARIZED
  CLUSTERED
}

enum WorkspaceCheckpointActorType {
  USER
  AGENT
  SYSTEM
}

enum CanvasViewType {
  MANUAL
  ORGANIZER
}

enum AgentJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model AgentProfile {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  status    AgentProfileStatus @default(ACTIVE)
  maxCapabilityRung Int        @default(3)
  enabledRungs Int[]           @default([0, 1, 2, 3])
  allowedCanvasIds String[]    @default([])
  defaultModelCredentialId String?
  defaultModelCredential ModelCredential? @relation("DefaultModelCredential", fields: [defaultModelCredentialId], references: [id], onDelete: SetNull)
  integrationAccounts IntegrationAccount[]
  agentActions AgentAction[]
  changeSets  ChangeSet[]
  suggestions Suggestion[]
  jobs        AgentJob[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([defaultModelCredentialId])
}

model ModelCredential {
  id        String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   ModelProvider
  label      String
  baseUrl    String?
  defaultModel String
  encryptedSecret String
  secretFingerprint String
  capabilities Json?
  dailySpendCap Float?
  monthlySpendCap Float?
  status      CredentialStatus @default(UNVERIFIED)
  lastVerifiedAt DateTime?
  defaultForProfiles AgentProfile[] @relation("DefaultModelCredential")
  agentActions AgentAction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, secretFingerprint])
  @@index([userId, provider, status])
}

model IntegrationAccount {
  id        String                 @id @default(cuid())
  agentProfileId String
  agentProfile AgentProfile        @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  providerType IntegrationProviderType
  externalAccountId String
  authMode   IntegrationAuthMode
  encryptedSecretOrHash String
  secretPrefix String?
  secretSuffix String?
  replayCursor Json?
  status     IntegrationStatus     @default(ACTIVE)
  lastSeenAt DateTime?
  agentActions AgentAction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerType, externalAccountId])
  @@index([agentProfileId, status])
  @@index([secretPrefix, secretSuffix])
}

model AgentAction {
  id        String            @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentProfileId String
  agentProfile AgentProfile   @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  integrationAccountId String?
  integrationAccount IntegrationAccount? @relation(fields: [integrationAccountId], references: [id], onDelete: SetNull)
  modelCredentialId String?
  modelCredential ModelCredential? @relation(fields: [modelCredentialId], references: [id], onDelete: SetNull)
  kind      AgentActionKind
  rung      Int
  status    AgentActionStatus
  summary   String
  requestFingerprint String
  metadata  Json?
  changeSets ChangeSet[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([agentProfileId, createdAt])
  @@index([requestFingerprint])
}

model ChangeSet {
  id        String         @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentProfileId String
  agentProfile AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  agentActionId String?
  agentAction AgentAction? @relation(fields: [agentActionId], references: [id], onDelete: SetNull)
  scopeType  String
  scopeId    String
  status     ChangeSetStatus
  summary    String
  startedAt  DateTime @default(now())
  completedAt DateTime?
  revertedAt DateTime?
  changeRecords ChangeRecord[]

  @@index([userId, startedAt])
  @@index([agentActionId])
  @@index([scopeType, scopeId])
}

model ChangeRecord {
  id        String   @id @default(cuid())
  changeSetId String
  changeSet ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  operation  String
  before     Json?
  after      Json?
  reversible Boolean @default(true)
  revertedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([changeSetId])
  @@index([targetType, targetId])
}

model Suggestion {
  id        String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentProfileId String?
  agentProfile AgentProfile?  @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  kind      SuggestionKind
  status    SuggestionStatus  @default(OPEN)
  summary   String
  payload   Json
  expiresAt DateTime
  actedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, expiresAt])
  @@index([agentProfileId, createdAt])
}

model KnowledgeEntity {
  id        String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  title      String
  summary    String?
  status     KnowledgeEntityStatus @default(ACTIVE)
  attributes Json?
  sourceConfidence Float?
  itemLinks  ItemEntityLink[]
  outgoingRelations KnowledgeRelation[] @relation("KnowledgeRelationSource")
  incomingRelations KnowledgeRelation[] @relation("KnowledgeRelationTarget")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, entityType])
  @@index([userId, title])
}

model KnowledgeRelation {
  id        String                  @id @default(cuid())
  userId     String
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEntityId String
  sourceEntity KnowledgeEntity       @relation("KnowledgeRelationSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntityId String
  targetEntity KnowledgeEntity       @relation("KnowledgeRelationTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)
  relationType String
  summary    String?
  status     KnowledgeRelationStatus @default(ACTIVE)
  attributes Json?
  confidence Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sourceEntityId, targetEntityId, relationType])
  @@index([userId, relationType])
  @@index([sourceEntityId])
  @@index([targetEntityId])
}

model ItemEntityLink {
  id        String             @id @default(cuid())
  itemId     String
  item       CanvasItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  knowledgeEntityId String
  knowledgeEntity KnowledgeEntity @relation(fields: [knowledgeEntityId], references: [id], onDelete: Cascade)
  linkType   ItemEntityLinkType @default(SOURCE)
  confidence Float?
  createdAt  DateTime @default(now())

  @@unique([itemId, knowledgeEntityId, linkType])
  @@index([knowledgeEntityId])
}

model ItemEmbedding {
  id        String   @id @default(cuid())
  itemId     String
  item       CanvasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  provider   String
  model      String
  contentHash String
  vector     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([itemId, provider, model])
  @@index([provider, model])
}

model WorkspaceCheckpoint {
  id        String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopeType  String
  scopeId    String
  snapshot   Json
  reason     String
  createdByActorType WorkspaceCheckpointActorType
  createdByActorId String
  createdAt  DateTime @default(now())

  @@index([userId, scopeType, scopeId, createdAt])
}

model CanvasView {
  id        String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvasId   String
  canvas     Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  viewType   CanvasViewType
  name       String?
  filters    Json?
  layout     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, canvasId, viewType])
  @@index([canvasId])
}

model AgentJob {
  id        String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentProfileId String?
  agentProfile AgentProfile? @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  jobType    String
  status     AgentJobStatus @default(QUEUED)
  payload    Json
  result     Json?
  error      Json?
  scheduledAt DateTime @default(now())
  startedAt  DateTime?
  completedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([agentProfileId, createdAt])
}
