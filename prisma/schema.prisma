generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime? // null = not verified, DateTime = verified at
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  canvases      Canvas[]
  sessions      Session[]
  accounts      Account[]
  workspaces    Workspace[]

  createdItems  CanvasItem[] @relation("ItemCreatedBy")
  updatedItems  CanvasItem[] @relation("ItemUpdatedBy")
  deletedItems  CanvasItem[] @relation("ItemDeletedBy")
  comments      Comment[]

  activities    Activity[]
  apiKeys       ApiKey[]
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType
  canvasId    String?
  canvasName  String?
  itemId      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([canvasId, createdAt])
}

enum ActivityType {
  CANVAS_CREATED
  CANVAS_UPDATED
  CANVAS_DELETED
  CANVAS_SHARED
  ITEM_CREATED
  ITEM_UPDATED
  ITEM_DELETED
  COMMENT_ADDED
  TEMPLATE_CREATED
  TEMPLATE_USED
}

model Canvas {
  id          String      @id @default(cuid())
  name        String      @default("Untitled Canvas")
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CanvasItem[]
  shares      CanvasShare[]
  versions    CanvasVersion[]

  zoomLevel   Float       @default(1.0)
  panX        Float       @default(0)
  panY        Float       @default(0)

  // Thumbnail for preview (base64 encoded PNG)
  thumbnail   String?     @db.Text

  // Sharing settings
  isPublic    Boolean     @default(false)
  shareToken  String?     @unique // For public sharing links

  // Template settings
  isTemplate  Boolean     @default(false)
  templateDescription String?
  templateCategory String?
  usageCount  Int         @default(0)
  itemCount   Int         @default(0) // Denormalized count

  workspaceId String?
  workspace   Workspace?  @relation(fields: [workspaceId], references: [id])
  savedViews  SavedView[]
  connections ItemConnection[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([userId, isTemplate]) // For template listing by user (Issue #12)
  @@index([shareToken])
  @@index([isPublic]) // For public canvas discovery (Issue #12)
  @@index([isTemplate, templateCategory])
  @@index([isTemplate, usageCount, createdAt])
  @@index([workspaceId])
}

model CanvasVersion {
  id          String   @id @default(cuid())
  canvasId    String
  canvas      Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  name        String
  snapshot    Json     // Complete canvas state including items
  createdAt   DateTime @default(now())

  @@index([canvasId, createdAt])
}

model CanvasItem {
  id          String   @id @default(cuid())
  canvasId    String
  canvas      Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  type        ItemType

  positionX   Float
  positionY   Float
  width       Float
  height      Float
  zIndex      Int      @default(0)

  content     Json
  tags        String[] @default([])

  version     Int      @default(1)
  deletedAt   DateTime?

  createdById String
  updatedById String?
  deletedById String?
  createdBy   User     @relation("ItemCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("ItemUpdatedBy", fields: [updatedById], references: [id])
  deletedBy   User?    @relation("ItemDeletedBy", fields: [deletedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([canvasId, deletedAt])
  @@index([canvasId, type])
  @@index([canvasId, zIndex])
  @@index([canvasId, updatedAt])
  @@index([canvasId, positionX, positionY])
  @@index([canvasId, createdById]) // For filtering by creator (Issue #12)

  comments      Comment[]
  connectionsFrom ItemConnection[] @relation("ConnectionFrom")
  connectionsTo   ItemConnection[] @relation("ConnectionTo")
}

model Comment {
  id          String   @id @default(cuid())
  itemId      String
  item        CanvasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([itemId, deletedAt])
  @@index([itemId, createdAt]) // For chronological comments (Issue #12)
  @@index([userId])
  @@index([createdAt])
}

enum ItemType {
  NOTE
  BOOKMARK
  IMAGE
  DRAWING
  SHAPE
  ARROW
  TEXT
  FRAME
  EMBED
  POLL
}

enum ShareRole {
  VIEW    // Can only view
  COMMENT // Can view and comment
  EDIT    // Can view, comment, and edit
}

model CanvasShare {
  id        String    @id @default(cuid())
  canvasId  String
  canvas    Canvas    @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  email     String    // Email of person shared with
  role      ShareRole @default(VIEW)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([canvasId, email])
  @@index([canvasId])
  @@index([email])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceInfo   String?
  revokedAt    DateTime?

  @@index([userId])
  @@index([expires])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
  @@index([token, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
  @@index([token, expiresAt])
}

// Phase 5: New Models

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model ItemConnection {
  id        String   @id @default(cuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  fromId    String
  fromItem  CanvasItem @relation("ConnectionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  toItem    CanvasItem @relation("ConnectionTo", fields: [toId], references: [id], onDelete: Cascade)
  label     String?
  style     String   @default("SOLID")
  createdAt DateTime @default(now())

  @@unique([canvasId, fromId, toId])
  @@index([canvasId])
  @@index([fromId])
  @@index([toId])
}

// Workspace model - allows users to organize canvases into groups
model Workspace {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvases  Canvas[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// @deprecated This model is unused and will be removed in a future release.
// Deprecated: SavedView is currently unused. Keep for backwards compatibility, remove after migration plan.
model SavedView {
  id        String   @id @default(cuid())
  name      String
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canvasId])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String
  userId      String
  path        String
  method      String
  createdAt   DateTime @default(now())
  lockedAt    DateTime @default(now())
  
  responseCode Int?
  responseBody Json?

  @@unique([key, userId, method, path])
  @@index([userId, key])
  @@index([createdAt]) // For cleanup cron jobs
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  keyPrefix String?
  keySuffix String?
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime?
  lastUsedAt DateTime?
  revokedAt DateTime?
  
  @@index([userId])
  @@index([key])
}
